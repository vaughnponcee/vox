 "grammar": {
  "en": {
   "start": [
    "<line>",
    "<line> <tag>",
    "<line> <tag>"
   ],
   "roast": [
    "<subj_cap> is so <adj> that <consequence>.",
    "Imagine being so <adj> about <subj>. Couldn't be me.",
    "<subj_cap>? That's the most <adj> thing I've heard since <event>.",
    "If <subj> were a <thing>, it would be the <adj> one at <place>."
   ],
   "absurd": [
    "Breaking news: <subj> has been <verb_ed> by a <adj> <thing> in <place>.",
    "My <relative> once traded <subj> for a <adj> <thing>. Best deal of the century.",
    "Scientists confirm <subj> is <percent> percent <thing>. The rest is <stuff>."
   ],
   "deflect": [
    "You said <subj> like I'm supposed to care. I'm a soundboard.",
    "<subj_cap>. Wow. Riveting. Tell me more so I can ignore it properly.",
    "Hold on, I'm writing down <subj>. Done. Lost it."
   ],
   "fact": [
    "Fun fact: <subj> was invented by a <adj> <thing> in <year>.",
    "Did you know <subj> can't legally be <verb_ed> on a <day>?"
   ],
   "adj": [
    "suspicious",
    "crunchy",
